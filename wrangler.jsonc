{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "tyfvhvu",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "1e537d1a-1a6e-4644-9ade-2ea782d97ac1","database_name": "yuguygu" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "9dc01ba63ca94469b74db18bd867c952" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
